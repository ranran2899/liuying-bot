# ========= 邮箱机器人配置 =========
# 暂时不支持
MAIL_BOTS='[
]
'




# 可选配置：
# APSCHEDULER_JOBSTORES - 任务存储配置
# APSCHEDULER_EXECUTORS - 执行器配置
# APSCHEDULER_JOB_DEFAULTS - 任务默认参数