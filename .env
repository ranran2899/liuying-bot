# 重连延迟时间(秒)，避免频繁重连导致被限制
QQ_RECONNECT_DELAY=10
# 最大重连次数，超过后不再尝试重连
QQ_MAX_RECONNECT=5

# ========= QQ 机器人配置示例（详细版）=========
