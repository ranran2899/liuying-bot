# NoneBot 配置

# 命令起始符，定义机器人识别的命令前缀，["/"]表示使用/开头的命令
COMMAND_START=[""]
# 命令分隔符，定义命令中的分隔符，["."]表示使用.分隔命令的不同部分
# COMMAND_SEP=["."]

# 超级用户，定义可以执行所有命令的用户，["123456789"]表示用户123456789
SUPERUSERS=["2027839379"]
# 机器人昵称
NICKNAME=["流萤", "流萤酱"]
# 全局图片统一使用bytes发送，当流萤与协议端不在同一服务器上时为True
IMAGE_TO_BYTES = True

# 驱动器配置
DRIVER=~fastapi+~httpx+~websockets

# 平台超级用户，定义每个平台的超级用户，["123456789"]表示用户123456789
PLATFORM_SUPERUSERS = '
  {
    "qq": [""],
    "dodo": [""]
  }
'



# 服务器监听地址，0.0.0.0表示监听所有网卡接口
HOST=0.0.0.0
# 服务器监听端口，默认8080，可根据需要修改
PORT=8080

# OneBot 正向 WebSocket
# ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]

# 机器人访问令牌token
ONEBOT_ACCESS_TOKEN=abc1234
# ONEBOT_V11_ACCESS_TOKEN=abc1234
# ONEBOT_V12_ACCESS_TOKEN=v12访问令牌


# ========= 数据库配置 =========
# 示例: "postgresql+asyncpg://user:password@127.0.0.1:5432/database"
# 示例: "mysql+asyncmy://user:password@127.0.0.1:3306/database"
# 示例: "sqlite+aiosqlite:///data/db/liuying.db"
# 主数据库URL，推荐使用sqlite一键启动，桀桀桀
DB_URL = "sqlite+aiosqlite:///data/db/liuying.db"
# 辅助数据库URLS，用于读写分离等场景或者数据库同步
DB_URLS = '{
    "log_db": "sqlite+aiosqlite:///data/db/log.db",
    "bed_layout_db": "sqlite+aiosqlite:///data/db/bed_layout.db",
    "db1": "sqlite+aiosqlite:///data/db/liuying1.db",
    "db2": "sqlite+aiosqlite:///data/db/liuying2.db"
}'

# 数据库同步配置，正在测试中，还没有完善
# 是否开启数据库同步功能，默认False，必须先添加副数据库连接
DB_SYNC_ENABLED = False
# 数据库同步配置，指定需要同步主数据库的副数据库名称列表
DB_SYNC_SLAVES = ["db1", "db2"]
# 数据库同步间隔，单位为秒，默认1小时
DB_SYNC_INTERVAL = 3600


# 使用缓存Redis缓存，默认内存缓存
# NONE: 不使用缓存, MEMORY: 使用内存缓存, : 使用Redis缓存
CACHE_MODE = REDIS
# REDIS配置，使用REDIS替换Cache内存缓存
# REDIS地址
REDIS_HOST = "127.0.0.1"
# REDIS端口
REDIS_PORT = 6379
# REDIS密码
REDIS_PASSWORD = ""
# REDIS过期时间
REDIS_EXPIRE = 600

# Minecraft 适配器配置
# minecraft_ws_urls = '{
#     "world": ["ws://127.0.0.1:8081"]
# }'
# Minecraft 访问令牌
# minecraft_access_token=""



